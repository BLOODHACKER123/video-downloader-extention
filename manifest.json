
{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "0.2.0",
  "description": "Detect supported videos and manage downloads.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup.html"
  }
}
